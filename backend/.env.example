# Copy to .env and adjust. .env is gitignored.
#
# Only SECRET_KEY is mandatory in deployment; everything else has a working
# default. The application refuses to start with the development secret unless
# DEBUG is true, so a deployment cannot silently sign tokens with a key that is
# published in this repository.

# --- Security ---------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-key-change-me

# true on a laptop, false everywhere else. Controls log verbosity, and whether
# the development secret above is accepted at all.
DEBUG=true

# How long a login lasts. Default is one week.
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Network ----------------------------------------------------------------
# Origins allowed to call this API, comma separated. Must include the front
# end's deployed origin or every browser request will be blocked by CORS.
# CORS_ORIGINS=https://plately.example.com,https://www.plately.example.com

# --- Database ---------------------------------------------------------------
# SQLite by default, written next to the application. On a host with an
# ephemeral filesystem this must point at a mounted volume, or every deploy
# loses the data.
# DATABASE_URL=sqlite:///./plately.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/plately

# --- Media ------------------------------------------------------------------
# Where uploaded meal photos are written. Same persistence warning as above.
# MEDIA_ROOT=./media
# MAX_UPLOAD_BYTES=10485760

# --- Model ------------------------------------------------------------------
# Trained artifacts, produced by ml/train.py. Until these exist /classify
# returns 503 with a message saying so; the rest of the API works.
# MODEL_PATH=../ml/artifacts/model.keras
# CLASS_INDEX_PATH=../ml/artifacts/class_indices.json

# Predictions below this are flagged to the user as uncertain.
# LOW_CONFIDENCE_THRESHOLD=0.55

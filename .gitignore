# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local configuration and data
.env
*.db
backend/media/

# Training data and outputs — regenerate with ml/prepare_data.py and ml/train.py
ml/dataset/
ml/artifacts/*
# …but the served model is versioned. It is 9 MB, and Railway builds from
# git — without it in the repo the deployed API has no model to load and
# /classify answers 503 forever. model.keras stays out: only TFLite ships.
!ml/artifacts/model.tflite
!ml/artifacts/class_indices.json
ml/raw_food101/

# Your own photographs. Regenerating these means shooting them again, so keep
# a backup somewhere outside this checkout.
#
# …except the attribution table. Most of the web-sourced images are under
# licences that require credit, so the record of who took them has to be
# versioned even though the images themselves are not. Git will not look
# inside an excluded directory, hence the `/*` rather than `/`.
ml/raw_nigerian/*
!ml/raw_nigerian/CREDITS.csv

# Node
node_modules/
frontend/dist/

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/

# Word's lock files, which appear whenever a chapter is open
~$*.docx

# API credentials for the dataset harvester
ml/.openverse.json
ml/.flickr.json

# Unreviewed web downloads — staging only, never the training set
ml/web_harvest/
.docx-backups/
